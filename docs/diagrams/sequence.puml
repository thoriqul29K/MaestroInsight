@startuml MaestroInsight - Sequence Diagrams
!theme plain
skinparam sequenceArrowColor black
skinparam actorBorderColor black
skinparam participantBorderColor black

title **Sequence Diagram — MaestroInsight**

' ============================================================
' DIAGRAM 1: LOGIN
' ============================================================
left header **1. Login**
actor "Admin" as adm
participant "AuthController" as auth
participant "UserModel" as user
database "tb_user" as db
participant "Session" as sess

adm -> auth : GET /login
auth -> auth : render login.php
adm -> auth : POST /login\n(username, password)
auth -> user : findByUsername(username)
user -> db : SELECT * WHERE username = ?
db --> user : row
user --> auth : array | null

alt user found
  auth -> auth : password_verify(password, hash)
  alt password valid
    auth -> sess : set(isLoggedIn, user_id,\nusername, nama_lengkap, role)
    auth --> adm : redirect /dashboard
  else invalid
    auth -> sess : setFlashdata("error", "Password salah")
    auth --> adm : redirect /login
  end
else not found
  auth -> sess : setFlashdata("error", "Username tidak ditemukan")
  auth --> adm : redirect /login
end

' ============================================================
' DIAGRAM 2: SEGMENTASI RFM
' ============================================================
left header **2. Segmentasi RFM Clustering**

actor "Admin" as admin2
participant "AnalisisController" as ac
participant "RfmService" as rfm
database "tb_pelanggan\ntb_transaksi\ntb_rfm" as dbrfm
participant "File System\n(writable/uploads/)" as fs
participant "Python\nclustering.py" as py
participant "System\n(proc_open)" as proc

admin2 -> ac : POST /analisis/proses-rfm-cluster
ac -> ac : writeProgress(0%, "mulai")
ac -> rfm : hitungRFM()
rfm -> dbrfm : Query pelanggan + transaksi
dbrfm --> rfm : raw data
rfm -> rfm : Compute R, F, M\nMin-max normalize
rfm -> dbrfm : TRUNCATE tb_rfm
rfm -> dbrfm : INSERT ke tb_rfm
rfm --> ac : ['status'=>'ok', 'count'=>N]

ac -> ac : writeProgress(30%, "export")
ac -> rfm : exportToCSV('rfm_input.csv')
rfm -> dbrfm : SELECT id_pelanggan,\nrecency, frequency, monetary
rfm -> fs : write rfm_input.csv
fs --> rfm : true
rfm --> ac : true

ac -> ac : writeProgress(50%, "cluster")
ac -> ac : findPython() -> 'python'
ac -> proc : runWithTimeout('python clustering.py\n rfm_input.csv rfm_output.csv', 300)

|||
|Progress Polling|
|||
loop setiap ~2 detik
  admin2 -> ac : GET /analisis/progress
  ac -> fs : read clustering_progress.json
  fs --> ac : JSON
  ac --> admin2 : {percent, stage, detail}
end

|||
|Python Execution|
|||
py -> fs : read rfm_input.csv
py -> py : MinMaxScaler normalize
py -> py : linkage(ward, euclidean)
py -> py : fcluster(maxclust=5)
py -> py : label_segments\n(rank by monetary mean)
py -> fs : write rfm_output.csv
proc --> ac : exit code 0

ac -> ac : writeProgress(90%, "import")
ac -> rfm : importSegmentResults('rfm_output.csv')
rfm -> fs : read rfm_output.csv
rfm -> dbrfm : UPDATE tb_pelanggan\nSET segment = ? WHERE id = ?
rfm --> ac : count updated

ac -> ac : writeProgress(100%, "selesai")
ac --> admin2 : redirect + flashdata success

' ============================================================
' DIAGRAM 3: KIRIM PROMOSI
' ============================================================
left header **3. Kirim Promosi Email**

actor "Admin" as admin3
participant "PromosiController" as pc
participant "PelangganModel" as pm
participant "PromosiSender" as sender
participant "EmailChannel" as email
participant "service('email')" as mailer
database "tb_promosi_log" as logdb
entity "Gmail SMTP" as smtp

admin3 -> pc : GET /promosi
pc -> pm : getAllWithSegment()
pm --> pc : daftar pelanggan
pc --> admin3 : render form (pelanggan list)

admin3 -> pc : POST /promosi/kirim\n(id_pelanggan[], subject, pesan,\n channel='email', gambar)

pc -> pc : filter pelanggan\n(yang memiliki email)

loop untuk setiap pelanggan
  pc -> pc : personalize(pesan)
  note right: replace {nama} {segmen}

  pc -> sender : send('email', pelanggan,\nsubject, body, attachment)
  sender -> email : send(pelanggan, subject,\nbody, attachment)

  email -> mailer : setFrom() setTo()\nsetSubject() setMessage()

  alt attachment exists
    email -> mailer : attach(file)
  end

  email -> mailer : send()
  mailer -> smtp : SMTP (TLS 587)

  alt success
    smtp --> mailer : OK
    mailer --> email : true
    email --> sender : SendResult(true)
    sender --> pc : result
    pc -> logdb : INSERT status='success'
  else failed
    smtp --> mailer : error
    mailer --> email : false
    email --> sender : SendResult(false, errorMsg)
    sender --> pc : result
    pc -> logdb : INSERT status='failed',\nerror_message=...
  end
end

pc --> admin3 : redirect + summary\n"X berhasil, Y gagal"

@enduml
