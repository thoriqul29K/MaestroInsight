@startuml MaestroInsight - Class Diagram
!theme plain
skinparam classBorderColor black
skinparam classArrowColor black
skinparam interfaceBorderColor black

title **Class Diagram — MaestroInsight**
caption CodeIgniter 4.7 / PHP 8.2 — MVC Architecture

' ============================================================
' PACKAGES / NAMESPACES
' ============================================================
package "App\\Controllers" as CTRL {
  abstract class BaseController {
    + initController(RequestInterface, ResponseInterface, LoggerInterface)
  }

  class AuthController {
    + login()
    + doLogin()
    + logout()
  }

  class DashboardController {
    + index()
  }

  class PelangganController {
    - PelangganModel $model
    + __construct()
    + index()
    + create()
    + store()
    + edit(int $id)
    + update(int $id)
    + delete(int $id)
  }

  class TransaksiController {
    - TransaksiModel $model
    - PelangganModel $pelangganModel
    + __construct()
    + index()
    + create()
    + store()
    + edit(int $id)
    + update(int $id)
    + delete(int $id)
  }

  class AnalisisController {
    - RfmService $rfm
    - RfmModel $rfmModel
    - PelangganModel $pelanggan
    + __construct()
    + index()
    + prosesRFMCluster()
    + progress()
    - runClustering(int $timeout) : array
    - logClustering(string $message)
    - getClusteringLogPath() : string
    - writeProgress(int $pct, string $stage, string $detail)
    - readProgress() : array
    - runWithTimeout(string $cmd, int $timeout) : array
    - findPython() : ?string
    - terminateProcess($proc, array $pipes)
  }

  class PromosiController {
    - PelangganModel $model
    - PromosiLogModel $logModel
    - PromosiSender $sender
    + __construct()
    + index()
    + kirim()
    + riwayat()
    + hapusLog()
    + personalize(string $pesan, array $pelanggan) : string
  }
}

package "App\\Models" as MOD {
  class UserModel {
    + findByUsername(string $username) : ?array
  }
  note bottom : table: tb_user

  class PelangganModel {
    + getAllWithSegment() : array
    + countBySegment() : array
  }
  note bottom : table: tb_pelanggan

  class TransaksiModel {
    + getAllWithPelanggan() : array
    + getByPelanggan(int $id) : array
    + countAll() : int
    + getRecent(int $limit) : array
  }
  note bottom : table: tb_transaksi

  class RfmModel {
    + getByPelanggan(int $id) : ?array
    + getAllWithPelanggan() : array
  }
  note bottom : table: tb_rfm

  class PromosiLogModel {
    + getFiltered(?int $limit, ?string $status, ?string $channel, ?int $offset) : array
    + countByStatus(?string $since) : array
    + countFiltered(?string $status, ?string $channel) : int
    + deleteFiltered(?string $status, ?string $channel) : int
  }
  note bottom : table: tb_promosi_log
}

package "App\\Services" as SVC {
  class RfmService {
    - TransaksiModel $transaksi
    - RfmModel $rfm
    + __construct()
    + hitungRFM() : array
    - normalize(float $val, float $min, float $max) : float
    + exportToCSV(string $path) : bool
    + importSegmentResults(string $csvPath) : int
  }
}

package "App\\Libraries\\Promosi" as LIB {
  interface ChannelInterface {
    + {abstract} send(array $pelanggan, string $subject, string $body, ?string $attachment) : SendResult
  }

  class SendResult {
    + bool $success
    + ?string $errorMessage
    + __construct(bool $success, ?string $errorMessage)
  }

  class PromosiSender {
    - array $channels
    + __construct()
    + registerChannel(string $name, ChannelInterface $channel)
    + hasChannel(string $name) : bool
    + send(string $channelName, array $pelangganList, string $subject, string $body, ?callable $personalizer, ?string $attachment) : array
  }

  class EmailChannel {
    + send(array $pelanggan, string $subject, string $body, ?string $attachment) : SendResult
  }
}

package "App\\Filters" as FIL {
  class AuthFilter {
    + before($request, $arguments)
    + after($request, $response, $arguments)
  }
  note bottom : implements FilterInterface
}

' ============================================================
' RELATIONSHIPS — INHERITANCE
' ============================================================
BaseController <|-- AuthController
BaseController <|-- DashboardController
BaseController <|-- PelangganController
BaseController <|-- TransaksiController
BaseController <|-- AnalisisController
BaseController <|-- PromosiController

' ============================================================
' RELATIONSHIPS — ASSOCIATIONS
' ============================================================
PelangganController *--> PelangganModel
TransaksiController *--> TransaksiModel
TransaksiController *--> PelangganModel
AnalisisController *--> RfmService
AnalisisController *--> RfmModel
AnalisisController *--> PelangganModel
PromosiController *--> PelangganModel
PromosiController *--> PromosiLogModel
PromosiController *--> PromosiSender

RfmService *--> TransaksiModel
RfmService *--> RfmModel

' ============================================================
' RELATIONSHIPS — INTERFACE REALIZATION
' ============================================================
ChannelInterface <|.. EmailChannel

' ============================================================
' RELATIONSHIPS — DEPENDENCIES
' ============================================================
PromosiSender ..> ChannelInterface : uses
PromosiSender ..> SendResult : creates
EmailChannel ..> SendResult : creates

' ============================================================
' EXTERNAL / PYTHON
' ============================================================
package "External" as EXT #DDDDDD {
  class "clustering.py\n(Python)" as PyScript {
    + load_data_from_csv(path)
    + load_data_from_db(...)
    + normalize(df)
    + hierarchical_cluster(features, n_clusters, method, metric, timeout)
    + label_segments(df, labels, n_clusters)
    + write_output(df, path)
    + main()
  }
}

AnalisisController ..> PyScript : shell_exec

@enduml
